PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=gestor_practicas
# For a URI without credentials, set both variables below; otherwise leave both blank.
MONGODB_USERNAME=
MONGODB_PASSWORD=
# Optional. Common values are "admin" or the database name.
MONGODB_AUTH_SOURCE=
JWT_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_NAME=Administrador del sistema
BOOTSTRAP_ADMIN_EMAIL=admin@example.edu
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
